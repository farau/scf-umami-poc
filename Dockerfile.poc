# Dedicated, single-instance Railway POC. No HA or external datastore required for /scf.
FROM node:22.23.4-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat && npm install -g pnpm@12.3.4
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/mcp/package.json ./packages/mcp/
COPY packages/mcp/bin ./packages/mcp/bin/
RUN pnpm install --frozen-lockfile
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 DISABLE_TELEMETRY=1
# The Prisma client is generated but no database connection or migration runs.
ENV DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/scf_demo
RUN pnpm run build:db && pnpm run build:tracker:script && pnpm run build:packages && pnpm run build:app

FROM node:22.23.4-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1 DISABLE_TELEMETRY=1 SCF_DEMO_MODE=true
# Placeholder only. Override with Railway PostgreSQL URL for native Umami.
ENV DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/scf_demo
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/scripts/start-scf.mjs ./scripts/start-scf.mjs
USER nextjs
EXPOSE 3000
CMD ["node", "scripts/start-scf.mjs"]
